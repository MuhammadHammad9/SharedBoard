# Server environment for infra/docker-compose.prod.yml.
#   cp infra/env/server.env.example infra/env/server.env
# server.env is git-ignored. NEVER commit real values (R-SEC-016); a secret
# that reaches a commit must be ROTATED (docs/RUNBOOK.md §9).
# Full list and meaning: .env.example and apps/server/src/lib/env.ts.

# Postgres password must match infra/env/postgres.env. connection_limit makes
# the pool size explicit (the pool-saturation alert reads it).
DATABASE_URL=postgresql://coboard:CHANGE_ME@postgres:5432/coboard?connection_limit=10
REDIS_URL=redis://redis:6379

# openssl rand -base64 48 — two DIFFERENT values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# The public origin users load (Cloudflare hostname). CORS allow-list, R-SEC-014.
CLIENT_ORIGIN=https://coboard.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://coboard.example.com/api/auth/google/callback

# Required in production, or reset and invite emails are never delivered.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=CoBoard <no-reply@coboard.example.com>

S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=coboard-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# openssl rand -hex 24 — same value as infra/secrets/metrics_token.
METRICS_TOKEN=
