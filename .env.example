# CoBoard environment — TRD §15.3
#
# R-SEC-016 (Required): secrets come from environment variables. `.env` is
# git-ignored; this example file is committed and MUST NOT contain real values.
# A secret in a commit means ROTATING the secret, not just reverting the commit.
#
# Copy to .env and fill in:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Services. Identical whether you use `docker compose up -d` or
# `bash scripts/dev-services.sh`.
# Production: append `?connection_limit=N` so the pool size is explicit. The
# /metrics pool-utilisation signal reads N from here; without it the server
# can only estimate Prisma's default (CPUs × 2 + 1).
DATABASE_URL=postgresql://coboard:coboard@localhost:5432/coboard
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
# The two secrets MUST be different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Google OAuth (FR-AUTH-003, Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for image uploads and thumbnails (FR-CANVAS-010, Phase 13).
# These defaults point at the in-memory fake that `pnpm dev` starts on :4569
# (apps/server/src/dev/fakeS3.ts — no signature checks, development only).
# Production: a real S3 or MinIO endpoint, a bucket with public-read objects
# and CORS allowing GET and PUT from CLIENT_ORIGIN (decision D13-2).
S3_ENDPOINT=http://127.0.0.1:4569
S3_BUCKET=coboard
S3_ACCESS_KEY=dev-fake-s3
S3_SECRET_KEY=dev-fake-s3-secret
# Optional: where objects are read from, if not ${S3_ENDPOINT}/${S3_BUCKET}.
S3_PUBLIC_URL=

# Transactional email for password reset (FR-AUTH-004, Phase 7)
SMTP_URL=

# CORS allow-list — R-SEC-014, no wildcards
CLIENT_ORIGIN=http://localhost:5173

# Observability (Phase 15e, TRD §15.4). Prometheus scrapes GET /metrics with
# `Authorization: Bearer $METRICS_TOKEN`. Unset: open in development, and the
# endpoint is DISABLED in production. Generate with: openssl rand -hex 24
METRICS_TOKEN=

# Limits — mirrored in packages/shared/src/constants.ts
MAX_UPLOAD_BYTES=10485760
MAX_OBJECTS_PER_BOARD=50000
SNAPSHOT_INTERVAL_OPS=500
