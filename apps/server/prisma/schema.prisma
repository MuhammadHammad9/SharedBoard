// CoBoard database schema.
//
// Phase 1: datasource and generator only, with one empty initial migration to
// prove the connection. Models arrive with the phases that need them:
//   Phase 7  — User, RefreshToken, PasswordResetToken (DONE)
//   Phase 8  — Board, Operation, Snapshot, BoardMember (DONE)
//   Phase 12 — BoardMember, ShareLink, Role
//
// TRD §3.2, decision D-3: the op log is the source of truth. Do NOT add a
// mutable `Object` table and UPDATE rows — that loses free replay, idempotent
// outbox replay, ordering authority and auditability (anti-pattern A-07).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Phase 7 — authentication ─────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  /// Lower-cased copy of `email`, so lookup is case-insensitive without
  /// forcing a functional index or a citext extension. Both columns are
  /// unique: `email` preserves what the user typed, `emailLower` is what we
  /// match on.
  emailLower    String   @unique
  /// Null for OAuth-only accounts — TRD §3.1. An account created through
  /// Google has no password until the user sets one.
  passwordHash  String?
  displayName   String   @db.VarChar(40)
  avatarUrl     String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  ownedBoards    Board[]              @relation("BoardOwner")
  memberships    BoardMember[]
  operations     Operation[]

  @@index([emailLower])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  /// A SHA-256 hash, never the token itself — R-SEC-007. A database dump must
  /// not hand the reader a set of working sessions.
  tokenHash String    @unique
  /// Rotation lineage. Every token minted by refreshing another carries the
  /// original's id, so detecting reuse can revoke the whole family in one
  /// statement rather than walking a chain (R-SEC-006).
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  /// Hashed at rest for the same reason as a refresh token: whoever holds the
  /// plaintext can take over the account.
  tokenHash String    @unique
  expiresAt DateTime
  /// Single-use — FR-AUTH-004. Set on first successful reset; a second
  /// attempt with the same token is TOKEN_USED, not TOKEN_INVALID, so the
  /// user gets an accurate explanation.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Phase 8 — boards, the op log, and snapshots ──────────────────────────────

model Board {
  id           String    @id @default(uuid())
  name         String    @default("Untitled board") @db.VarChar(80)
  ownerId      String
  thumbnailUrl String?
  /// Last assigned op sequence number. Incremented inside the same
  /// transaction that inserts the op, which is what makes seq gap-free
  /// under concurrency (R-SYNC-013).
  currentSeq   Int       @default(0)
  /// Denormalised so the dashboard and the load path can decide whether a
  /// board is large without counting rows or replaying the log.
  objectCount  Int       @default(0)
  /// Soft delete — FR-BOARD-005. Trash keeps it for 30 days.
  deletedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())

  owner      User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    BoardMember[]
  operations Operation[]
  snapshots  Snapshot[]

  @@index([ownerId, deletedAt])
  @@index([lastActivityAt])
}

/// Membership and role. Sharing lands in Phase 12; the model exists now
/// because `GET /boards/:id` must report `myRole`, and because the owner
/// needs a membership row from the moment the board is created.
model BoardMember {
  id        String   @id @default(uuid())
  boardId   String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per person per board. The unique constraint is the
  /// enforcement — an invite race must not produce two rows with two roles.
  @@unique([boardId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

/// The op log — TRD §3.2, decision D-3. THE source of truth.
///
/// Append-only. There is deliberately no mutable `Object` table: the log
/// answers "what did I miss since seq 412?" with one indexed query, makes
/// outbox replay idempotent for free, and carries its own ordering authority.
/// The cost is that reading a board means replaying — which is what Snapshot
/// exists to bound.
model Operation {
  /// CLIENT-generated uuid, and the primary key. That is what makes replay
  /// idempotent (R-SYNC-014): a retried op collides on insert instead of
  /// duplicating the object.
  id         String   @id
  boardId    String
  /// Server-assigned, monotonic per board. The sole ordering authority
  /// (R-ARCH-008) — never a client timestamp.
  seq        Int
  type       OpType
  objectId   String
  payload    Json
  actorId    String?
  /// Guests have no User row, so their identity is a bare string.
  actorGuest String?
  createdAt  DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a user must not delete the board history
  /// everyone else is still working on.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([boardId, seq])
  @@index([boardId, seq])
  @@index([boardId, objectId])
}

enum OpType {
  CREATE
  UPDATE
  DELETE
}

/// Materialised state at a sequence number, so loading a board does not mean
/// replaying 50,000 ops — TRD §3.4.
model Snapshot {
  id        String   @id @default(uuid())
  boardId   String
  seq       Int
  /// { objects: BoardObject[] }
  state     Json
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, seq])
}
