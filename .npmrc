# Refuse to install a package whose `engines.node` excludes the running Node.
#
# Added after jsdom 30 — which declares `^22.22.2 || ^24.15.0 || >=26` — installed
# silently, passed on a Node 22 dev machine, and then died in CI on the Node 20
# LTS that TRD §1.1 pins, with a `webidl.util.markAsUncloneable is not a function`
# deep inside undici. The dependency was wrong for this project from the moment
# it was added, and nothing said so.
#
# Honest about what this buys: the check compares against the CURRENTLY RUNNING
# Node, so on a newer dev machine it still will not flag a package that needs
# more than Node 20. What it does guarantee is that CI — which runs Node 20 —
# fails at `pnpm install` with the package name and the version range, instead
# of at runtime with a stack trace three layers into a transitive dependency.
engine-strict=true
